MONGODB_CONNECTION_STRING=mongodb://username:password@localhost:27017/featbit

# Replace username, password, host and port with your PostgreSQL server details.
# URL-encode special characters in credentials (e.g. @ becomes %40).
# Both connections normally use the same server and may use the same account.

# Used by npm run init-postgres. Connect to an existing administrative database,
# normally postgres, because the featbit database does not exist yet.
# The account needs permission to create the database and the pg_trgm extension.
# Initialization creates and switches to a database named featbit; this name is fixed.
POSTGRES_ADMIN_CONNECTION_STRING=postgresql://username:password@localhost:5432/postgres

# Used by npm run export-from-mongodb to check the target schema and verify all tables are empty.
# Connect to featbit after npm run init-postgres has completed successfully.
# Also used by npm run import-into-postgres to import the exported CSV files.
# If using a different account, grant it access to the initialized schema and tables,
# including the permissions needed to read, lock and import into the target tables.
POSTGRES_CONNECTION_STRING=postgresql://username:password@localhost:5432/featbit

# Export stops before creating output if EndUsers exceeds this count.
# Increase only after assessing data size and migration time; no records are silently skipped.
END_USERS_AUTO_MIGRATION_LIMIT=10000
